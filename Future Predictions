#Need to use simplified GAM for forecasting as there are too many interactive variables to hold at mean

#predicting future holding 2023 patterns  
monthly_means_2023 <- ALL_Mo_TC_Dec %>%
  filter(Year == 2023) %>%
  group_by(Month_Number) %>%
  summarise(
    Effort     = mean(Effort, na.rm = TRUE),
    CPUE_final = mean(CPUE_final, na.rm = TRUE),
    Income     = mean(Income, na.rm = TRUE),
    .groups = "drop"
  )
last_year23 <- max(ALL_Mo_TC_Dec$year, na.rm = TRUE)

future_newdata_2023trend <- expand_grid(
  year = (last_year23 + 1):(last_year23 + 5),
  Month_Number = 1:11
) %>%
  left_join(monthly_means_2023, by = "Month_Number")

#using simplifed GAM as there are too many interactive effects to capture model nicely
m_catch_forecast <- gam(
  Catch ~
    s(Month_Number, bs="cc", k=11) +
    s(year, k=8) +
    s(Effort, k=8) +
    s(CPUE_final, k=8) +
    ti(Effort, Month_Number) +
    ti(CPUE_final, Month_Number),
  family = Gamma(link="log"),
  data = ALL_Mo_TC_Dec,
  select = TRUE
)

#instead of full model: Catch ~ s(Effort) + s(CPUE_final) + te(year, Month_Number) + 
#te(year, Effort) + te(year, Income) + te(year, CPUE_final)

pred_link23 <- predict(m_catch_forecast, newdata = future_newdata_2023trend, type = "link", se.fit = TRUE)

future_pred23 <- future_newdata_2023trend %>%
  mutate(
    fit_link = pred_link23$fit,
    se_link  = pred_link23$se.fit,
    Catch_fit = exp(fit_link),
    Catch_low = exp(fit_link - 1.96 * se_link),
    Catch_high= exp(fit_link + 1.96 * se_link)
  )
