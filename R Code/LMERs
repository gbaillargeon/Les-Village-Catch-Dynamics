#Linear Mixed Effects Models
#For added location and gear data for 2022-2023 only
#Individual fisher based LMER for complete time series
#Data: All_Mo_TC_Dec and dfFisherSum and LMER_data

selected_data_std <- as.data.frame(scale(filtered_data[, c("Total_SpCatch_Mo", "Fishing_Trips_Mo", "CPUE")]))
selected_data_std$Gear <- LMER_data$Gear
selected_data_std$Location <- filtered_data$Location
selected_data_std$Month <- filtered_data$Month
selected_data_std$year <- filtered_data$Year
selected_data_std
library(lme4)
library(MuMIn)

#LMER
options(na.action = "na.fail")  # Required for dredge
model_full <- lmer(Total_SpCatch_Mo ~ year*Gear + Location*year + Gear*Location + (1|Month), data=selected_data_std)
model_set <- dredge(model_full)
model_set 
#final model for catch
CatchLMER <- lmer(Total_SpCatch_Mo ~
                    Gear +
                    Location +
                    year +
                    Gear:Location +
                    Location:year +
                    (1 | Month), data = selected_data_std)
summary(CatchLMER)
Anova(CatchLMER, type = "III")

#LMER CPUE
options(na.action = "na.fail")  # Required for dredge
model_full_cpue <- lmer(CPUE ~ year*Gear + Location*year + Gear*Location + (1|Month), data=selected_data_std)
model_set_cpue <- dredge(model_full_cpue)
model_set_cpue
#final model CPUE
best_model_cpue <- lmer(CPUE ~ Gear*Location + year + Location + (1|Month), data= selected_data_std)
summary(best_model_cpue)
Anova(best_model_cpue, type = "III")

#LMER EFFORT 
options(na.action = "na.fail")  # Required for dredge
model_full_e <- lmer(Fishing_Trips_Mo ~ year*Gear + Location*year + Gear*Location + (1|Month), data=selected_data_std)
model_set_e <- dredge(model_full_e)
model_set_e
#final model effort
best_model_e <- lmer(Fishing_Trips_Mo ~ year*Location + Gear + Location + (1|Month), data= selected_data_std)
summary(best_model_e)
Anova(best_model_e, type="III")

#Individual Fisher LMER
df_clean <- df_fisherSum |>
  dplyr::select(Total_Catch, Days_Fished, Total_Income, Year, Fisher, Month) |>
  na.omit()
#using dredge to find best fitting model for catch and income  
library(MuMIn)
options(na.action = "na.fail")  # Required for dredge
model_fisherInc<- lmer(scale(Total_Catch) ~ scale(Days_Fished)*scale(Total_Income) + Year*Month+ 
                         (1 | Fisher), data = df_fisherSum)
search_Inc <- dredge(model_fisherInc)  
search_Inc
df_clean
#final catch model
Catch_mod <- lmer(scale(Total_Catch) ~
                    scale(Days_Fished) * scale(Total_Income) +
                    Year +
                    (1 | Fisher), data=df_clean)
summary(Catch_mod)
Anova(Catch_mod, type="III")
r.squaredGLMM(Catch_mod)

##Income LMER
options(na.action = "na.fail")  # Required for dredge
model_fisherIncx<- lmer(scale(Total_Income) ~ scale(Days_Fished)*scale(Total_Catch) + Year*Month+ 
                          (1 | Fisher), data = df_clean)
search_Incx <- dredge(model_fisherIncx)  
search_Incx
#final best fit model for income
Final_FisherInc <- lmer(scale(Total_Income) ~
                          scale(Total_Catch) + Year + (1 | Fisher), data=df_clean)
summary(Final_FisherInc) 
Anova(Final_FisherInc, Type="III") 
r.squaredGLMM(Final_FisherInc)

#now for cpue (fish per fisher per month)
df_clean <- df_clean %>% 
  mutate(
    Fisher_CPUE = Total_Catch/Days_Fished)
df_clean

options(na.action = "na.fail")  # Required for dredge
model_fisherCPUE<- lmer(scale(Fisher_CPUE) ~ scale(Days_Fished)*scale(Total_Catch)*scale(Total_Income) + Year*Month+ 
                          (1 | Fisher), data = df_clean)
search_CPUE <- dredge(model_fisherCPUE)  
search_CPUE
str(df_clean)
#a lot of explanatory power is absorbed by catch and effort which directly contribute to cpue calc
#final model is 
Final_FisherCPUE <- lmer(scale(Fisher_CPUE) ~
                           scale(Days_Fished) +
                           scale(Total_Catch) +
                           scale(Total_Income) +
                           scale(Days_Fished):scale(Total_Catch) +
                           scale(Days_Fished):scale(Total_Income) +
                           scale(Total_Catch):scale(Total_Income) +
                           Year +
                           (1 | Fisher), data=df_clean)
summary(Final_FisherCPUE)
Anova(Final_FisherCPUE, type="III")
Fgamr.squaredGLMM(Final_FisherCPUE)
