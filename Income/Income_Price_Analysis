#make new dataframe for plotting average weighted fisher income by year
df_indivYEAR<- df_fisherSum %>%
  group_by(Year) %>%
  summarise(
    weighted_avg_income = weighted.mean(Total_Income, Days_Fished, na.rm = TRUE),
    weighted_sd_income = sqrt(
      sum(Days_Fished * (Total_Income - weighted.mean(Total_Income, Days_Fished, na.rm = TRUE))^2, na.rm = TRUE) /
        sum(Days_Fished, na.rm = TRUE)
    ),
    weighted_avg_catch = weighted.mean(Total_Catch, Days_Fished, na.rm = TRUE),
    weighted_sd_catch = sqrt(
      sum(Days_Fished * (Total_Catch - weighted.mean(Total_Catch, Days_Fished, na.rm = TRUE))^2, na.rm = TRUE) /
        sum(Days_Fished, na.rm = TRUE)
    ),
    .groups = "drop"
  )
df_indivYEAR$Year <- as.numeric(as.character(df_indivYEAR$Year))

ggplot(df_indivYEAR, aes(x = Year, y = weighted_avg_income)) +
  geom_line(size=1, color="gray")+
  geom_point(size=1.5)+
  annotate(
    "rect",
    ymin = 546400, ymax = 1512000,
    xmin = -Inf, xmax = Inf,
    fill = "lightblue", alpha = 0.6) + 
  geom_hline(yintercept = 765000, linetype = "dashed", color = "red", size = 1, alpha =0.6) +
  geom_hline(yintercept = 546400, linetype = "dashed", color = "red", size = 1, alpha =0.6) +
  geom_hline(yintercept = 1512000, linetype = "dashed", color = "red", size = 1, alpha =0.6) +
  ## Confidence band from your SDs
  geom_errorbar(aes(
    ymin = weighted_avg_income - weighted_sd_income,
    ymax = weighted_avg_income + weighted_sd_income
  ),
  width = 0.2, color = "grey"
  ) +
  labs(
    title = "Average Monthly Fisher Income by Year",
    x = "Year",
    y = "Weighted Average Monthly Fisher Income"
  ) +
  coord_cartesian(ylim = c(0, NA)) +  #  zooms but keeps all data
  #scale_y_continuous(labels = label_number(big.mark = ","))+
  scale_x_continuous(
    breaks = seq(
      from = min(df_indivYEAR$Year, na.rm = TRUE),
      to   = max(df_indivYEAR$Year, na.rm = TRUE),
      by   = 2
    )
  )+
  theme_classic()

