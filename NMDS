#NonMetric Dimensional Scaling
#Data: MonthlyMaster_Species and YearlyMaster_Species
library(dplyr)
library(tidyr)
library(vegan)
library(ggplot2)

# First get the top 50 species names as a vector
top50_species <- MonthlyMaster_Species |>
  filter(Species != "Lysmata amboinensis") |>
  group_by(Species, Year) |>
  summarise(annual_catch = sum(Total_Catch, na.rm = TRUE), .groups = "drop") |>
  group_by(Species) |>
  summarise(mean_annual_catch = mean(annual_catch, na.rm = TRUE)) |>
  slice_max(mean_annual_catch, n = 50) |>
  pull(Species)  # this extracts just the species names as a vector

# filter original dataframe to those species
top50_df <- MonthlyMaster_Species |>
  filter(Species %in% top50_species,
         Species != "Lysmata amboinensis")
top50_df
#Summarize total catch per Year × Month × Species
comm_matrix <- top50_df %>%
  group_by(Year, Month, Species) %>%
  summarise(Total_Catch = sum(Total_Catch, na.rm = TRUE), .groups = "drop") %>%
  pivot_wider(
    names_from = Species,
    values_from = Total_Catch,
    values_fill = 0
  )

#Keep Year/Month as metadata
sample_metadata <- comm_matrix %>% select(Year, Month)

#Extract species-only matrix for NMDS
species_matrix <- comm_matrix %>% select(-Year, -Month)

#Run NMDS using Manhattan distance
nmds_result <- metaMDS(species_matrix, distance = "manhattan", k = 2, trymax = 100)
nmds_result$stress
#Extract NMDS site scores
site_scores <- as.data.frame(scores(nmds_result, display = "sites"))
site_scores$Year <- sample_metadata$Year

#Plot
ggplot(site_scores, aes(x = NMDS1, y = NMDS2, color = as.factor(Year))) +
  geom_point(size = 3, alpha = 0.8) +
  theme_minimal() +
  labs(color = "Year") +
  ggtitle("NMDS of Top 25 Species per Year by Total Catch") +
  theme(plot.title = element_text(hjust = 0.5))

# Fit species vectors with envfit
species_envfit <- envfit(nmds_result, species_matrix, permutations = 999)

# Extract significant species vectors
vec_scores <- as.data.frame(species_envfit$vectors$arrows)
vec_scores$r2 <- species_envfit$vectors$r
vec_scores$pval <- species_envfit$vectors$pvals

vec_scores
sig_species <- subset(vec_scores, pval < 0.002)
sig_species

# Scale arrows for plotting
arrow_mult <- 1.1
sig_species$NMDS1_end <- sig_species$NMDS1 * arrow_mult
sig_species$NMDS2_end <- sig_species$NMDS2 * arrow_mult
site_scores

#need a matrix without months
comm_matrixYRS <- top50_df %>%
  group_by(as.numeric(Year), Species) %>%
  summarise(Total_Catch = sum(Total_Catch, na.rm = TRUE), .groups = "drop") %>%
  pivot_wider(
    names_from = Species,
    values_from = Total_Catch,
    values_fill = 0
  )
comm_matrixYRS
dist_mat <- vegdist(comm_matrixYRS, method = "manhattan")
hc <- hclust(dist_mat, method = "ward.D2")
plot(hc)
# Try several values of k
sil_width <- c()
library(cluster)

for (k in 2:(nrow(comm_matrixYRS) - 1)) {
  pam_fit <- pam(dist_mat, diss = TRUE, k = k)
  sil_width[k] <- pam_fit$silinfo$avg.width
}
plot(1:length(sil_width), sil_width, type = "b")
#5 was best

year_clusters <- cutree(hc, k = 5)
year_clusters
#fill in year clusters

year_clusters <- c(
  "2012" = 1,
  "2013" = 2,
  "2015" = 3,
  "2016" = 4,
  "2017" = 3,
  "2018" = 3,
  "2019" = 3,
  "2022" = 3,
  "2023" = 5
)

site_scores$Cluster <- year_clusters[as.character(site_scores$Year)]

head(site_scores)
sig_species

#add year as nmds centroid to be able to plot year as text
year_centroids <- site_scores %>%
  group_by(Year) %>%
  summarise(
    NMDS1 = mean(NMDS1),
    NMDS2 = mean(NMDS2)
  )
##ADJUSTING FOR YEAR CLUSTERS 
# Calculate year centroids
year_centroids <- site_scores %>%
  group_by(Year) %>%
  summarise(NMDS1 = mean(NMDS1), NMDS2 = mean(NMDS2))

# Hierarchical clustering
dist_mat <- dist(year_centroids[, c("NMDS1", "NMDS2")])
hc <- hclust(dist_mat, method = "ward.D2")
plot(hc)
year_centroids
# Cut tree into k groups (choose k)
year_centroids$cluster <- cutree(hc, k = 5)

# Merge cluster info back into site_scoresCP
site_scores <- left_join(site_scores, year_centroids[, c("Year", "cluster")], by = "Year")
year_centroids


