#count how often species were caught each year
species_year_summary <- YearlYMaster_Species %>%
  filter(!is.na(Species), Species != "#N/A") %>% 
  mutate(Species = str_trim(Species)) %>%
  mutate(Year = as.numeric(Year)) %>%
  group_by(Species) %>%
  summarise(
    total_sp = n_distinct(YearlYMaster_Species$Species),
    years_caught = n_distinct(Year[Total_Catch_Yr > 0]),
    total_years = 9,
    years_not_caught = total_years - years_caught,
    perc_years_not_caught = (years_not_caught / total_years) * 100,
    .groups = "drop"
  )

species_year_summary

#now find species that are not caught >80% of the time 
species_absent_80 <- species_year_summary %>%
  filter(perc_years_not_caught >= 80) %>%
  arrange(desc(perc_years_not_caught))

#now find species that are caught in  100% of years
species_present_90 <- species_year_summary %>%
  filter(perc_years_not_caught == 0) %>%
  arrange(desc(perc_years_not_caught))

#now extract catch, income data for species present in all years 
species_names_90 <- species_present_90 %>%
  pull(Species)

Top_Speices_Data <- YearlYMaster_Species %>%
  filter(Species %in% species_names_90)

#check overlap between the top 20 and species caught 100% of time
top20_names <- Top20_consistency$Species
top_sp_names <- Top_Speices_Data$Species
top20_namesI <- Top20_consistencyI$Species

in_both_sp <- intersect(top20_names, top_sp_names)
in_both_spI <- intersect(top20_names, top20_namesI) #overlap in sp in top 20 anually for catch and income 
in_both_spCI <- intersect(top20_namesI, top_sp_names)
final_overlap <- intersect(in_both_sp, in_both_spI)
