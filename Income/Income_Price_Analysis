#create clean dataframe for plotting
Top5_price_distr_clean <- Top5_price_distr %>%
  filter(!is.na(Price), !is.na(Species), !is.na(Year)) %>%      # remove NAs
  mutate(
    Price = as.numeric(Price),                                   # ensure numeric
    Species = factor(Species),                                   # factor for y-axis
    Year = factor(Year, levels = sort(unique(Year)),             # show actual years
                  labels = sort(unique(Year)))
  ) %>%
  # reorder species by overall mean price for better vertical spacing
  group_by(Species) %>%
  mutate(mean_price = mean(Price, na.rm = TRUE)) %>%
  ungroup() %>%
  mutate(Species = fct_reorder(Species, mean_price))

# 2️⃣ Plot
ggplot(Top5_price_distr_clean, 
       aes(x = Price, y = Species, fill = Year, group = interaction(Species, Year))) +
  geom_density_ridges(scale = 1, rel_min_height = 0.001, alpha = 0.5) +  # vertical spacing adjusted
  scale_fill_viridis(discrete = TRUE, option = "D", name = "Year") +
  coord_cartesian(xlim = c(0, 5000)) +                     # x-axis limit
  scale_y_discrete(expand = expansion(mult = c(0.002, 0.005))) + # add padding between ridges
  labs(title = "Price Distributions of Top 5 Species Over Years",
       x = "Price",
       y = "Species") +
  theme_ipsum() +
  theme(
    legend.position = "right",
    strip.text.x = element_text(size = 8)
  )

