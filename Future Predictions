#now simulate a 30% reduction in catch in 2024 based on 2023 data
#will use historical means in terms of modeling still to retain year-month seasonal trends from hist avgs
baseline_2023 <- 113552
target_prop   <- 0.70
target_annual <- baseline_2023 * target_prop  
target_annual
first_mgmt_year <- min(future_predAVG$year)

future_step <- future_predAVG %>%
  mutate(Scenario = "30% of 2023 annual (each year)") %>%
  group_by(year) %>%                           # <-- group by YEAR only
  mutate(
    year_total = sum(Catch_fit, na.rm = TRUE), # annual total from monthly predictions
    scale_fac  = ifelse(year < first_mgmt_year, 1, target_annual / year_total),
    
    Catch_fit_ss  = Catch_fit  * scale_fac,
    Catch_low_ss  = Catch_low  * scale_fac,
    Catch_high_ss = Catch_high * scale_fac
  ) %>%
  ungroup()
future_step

