#Code for Generalized Additive Models
#Data: All_Mo_TC_Dec
library(ggeffects)
library(gratia)
library(mgcv)
set.seed(23)

#month mapping
month_mapping <- c("January"=1, "February"=2, "March"=3, "April"=4, "May"=5, "June"=6,
                   "July"=7, "August"=8, "September"=9, "October"=10, "November"=11, "December"=12)
ALL_Mo_TC_Dec$Month_Number <- month_mapping[ALL_Mo_TC_Dec$Month]
ALL_Mo_TC_Dec$Month_Number <- as.numeric(ALL_Mo_TC_Dec$Month_Number)
ALL_Mo_TC_Dec$year <- as.numeric(ALL_Mo_TC_Dec$Year)

#checking data strucutre
mean_catch <- mean(ALL_Mo_TC_Dec$Catch)
var_catch <- var(ALL_Mo_TC_Dec$Catch)
mean_catch
var_catch
hist(ALL_Mo_TC_Dec$Catch)

#Single Variable GAM
C2 <- gam(Catch ~  s(Month_Number), family=Gamma(link="log"),method="REML",
          data = ALL_Mo_TC_Dec)
C3 <- gam(Catch ~  s(Year, k=9), family=Gamma(link="log"), 
        data = ALL_Mo_TC_Dec)
C4 <- gam(Catch ~  s(Effort), family=Gamma(link="log"), method="REML",
           data = ALL_Mo_TC_Dec)
